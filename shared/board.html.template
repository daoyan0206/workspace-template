<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>需求看板 | <PROJECT_NAME></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg: #0f1115;
    --panel: #1a1d24;
    --border: #2a2f3a;
    --text: #e6e8ec;
    --muted: #8a93a3;
    --accent: #4f8cff;
    --doing: #4f8cff;
    --await: #f5b342;
    --done: #3ecf8e;
    --blocked: #ef5b6b;
    --paused: #8a93a3;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 24px;
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 14px;
  }
  header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px; flex-wrap: wrap; gap: 12px;
  }
  h1 { margin: 0; font-size: 20px; font-weight: 600; }
  .meta { color: var(--muted); font-size: 12px; }
  .meta code { background: var(--panel); padding: 2px 6px; border-radius: 4px; }
  .legend { display: flex; gap: 10px; flex-wrap: wrap; }
  .badge {
    display: inline-block; padding: 3px 10px; border-radius: 12px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.3px;
  }
  .badge-doing  { background: rgba(79,140,255,0.15);  color: var(--doing); }
  .badge-await  { background: rgba(245,179,66,0.15);  color: var(--await); }
  .badge-done   { background: rgba(62,207,142,0.15);  color: var(--done); }
  .badge-blocked{ background: rgba(239,91,107,0.15);  color: var(--blocked); }
  .badge-paused { background: rgba(138,147,163,0.15); color: var(--paused); }
  table {
    width: 100%; border-collapse: separate; border-spacing: 0;
    background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
    overflow: hidden;
  }
  th, td {
    padding: 12px 14px; text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  th {
    background: #20242d; color: var(--muted);
    font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(255,255,255,0.02); }
  .topic-name { font-weight: 600; color: var(--accent); }
  .stage { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 13px; }
  .artifact code {
    background: #11141a; padding: 2px 6px; border-radius: 4px;
    font-size: 12px; color: #c4cbd6; word-break: break-all;
  }
  .waiting { color: var(--text); }
  .notes { color: var(--muted); font-size: 12px; }
  .empty { padding: 40px; text-align: center; color: var(--muted); }
  .stage-hint {
    margin-top: 24px; background: var(--panel); border: 1px solid var(--border);
    border-radius: 8px; padding: 14px 18px; font-size: 12px; color: var(--muted);
  }
  .stage-hint h3 { margin: 0 0 8px 0; color: var(--text); font-size: 13px; }
  .stage-hint ul { margin: 0; padding-left: 20px; }
  .stage-hint li { margin: 4px 0; }
  .stage-hint code { background: #11141a; padding: 1px 5px; border-radius: 3px; color: #c4cbd6; }
  .refresh-tip {
    color: var(--muted); font-size: 11px;
    background: var(--panel); padding: 4px 10px; border-radius: 4px;
    border: 1px solid var(--border);
  }
</style>
</head>
<body>

<header>
  <div>
    <h1>📋 <PROJECT_NAME> 需求看板</h1>
    <div class="meta">数据源:<code>shared/board.json</code> · 更新时间:<span id="updated-at">—</span></div>
  </div>
  <div class="legend">
    <span class="badge badge-doing">doing 进行中</span>
    <span class="badge badge-await">await 等用户</span>
    <span class="badge badge-done">done 完成</span>
    <span class="badge badge-blocked">blocked 阻塞</span>
    <span class="badge badge-paused">paused 暂停</span>
    <span class="refresh-tip">按 F5 刷新</span>
  </div>
</header>

<table>
  <thead>
    <tr>
      <th style="width:12%">Topic</th>
      <th style="width:12%">阶段</th>
      <th style="width:8%">状态</th>
      <th style="width:22%">最新产物</th>
      <th style="width:22%">等待动作</th>
      <th style="width:10%">负责角色</th>
      <th style="width:14%">备注</th>
    </tr>
  </thead>
  <tbody id="rows">
    <tr><td colspan="7" class="empty">加载中...</td></tr>
  </tbody>
</table>

<div class="stage-hint">
  <h3>流程阶段速查</h3>
  <ul>
    <li><code>Step 1</code> prd-planner 出 <code>prd/&lt;topic&gt;-v1.md</code> (纯需求)</li>
    <li><code>Step 2</code> visual-design 出线框 + 合并为 <code>prd/&lt;topic&gt;-v2.md</code></li>
    <li><code>Human(Figma)</code> 设计师据 v2 在 Figma 出终稿,完成后给主 agent URL</li>
    <li><code>Step 3</code> figma-to-prd 回灌终稿为 <code>prd/&lt;topic&gt;-v3.md</code></li>
    <li><code>Step 4</code> data-analyst 出 <code>data-reports/&lt;topic&gt;-events.md</code></li>
    <li><code>Step 5</code> 主 agent 汇总</li>
  </ul>
</div>

<!-- BOARD_DATA_START -->
<script id="board-data" type="application/json">
{
  "updatedAt": "<INIT_TIMESTAMP>",
  "schemaVersion": 1,
  "topics": []
}
</script>
<!-- BOARD_DATA_END -->

<script>
(function(){
  const raw = document.getElementById('board-data').textContent;
  let data;
  try { data = JSON.parse(raw); }
  catch(e) {
    document.getElementById('rows').innerHTML =
      '<tr><td colspan="7" class="empty">board.json 解析失败:' + e.message + '</td></tr>';
    return;
  }

  document.getElementById('updated-at').textContent = data.updatedAt || '未知';

  const tbody = document.getElementById('rows');
  if (!data.topics || data.topics.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" class="empty">暂无 topic</td></tr>';
    return;
  }

  const escape = s => String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

  tbody.innerHTML = data.topics.map(t => {
    const statusClass = 'badge badge-' + (t.status || 'doing');
    return `
      <tr>
        <td class="topic-name">${escape(t.name)}</td>
        <td class="stage">${escape(t.stage)}</td>
        <td><span class="${statusClass}">${escape(t.status)}</span></td>
        <td class="artifact">${t.latestArtifact ? '<code>' + escape(t.latestArtifact) + '</code>' : '<span class="notes">—</span>'}</td>
        <td class="waiting">${escape(t.waitingFor) || '<span class="notes">—</span>'}</td>
        <td>${escape(t.owner) || '<span class="notes">—</span>'}</td>
        <td class="notes">${escape(t.notes) || '—'}</td>
      </tr>
    `;
  }).join('');
})();
</script>

</body>
</html>
